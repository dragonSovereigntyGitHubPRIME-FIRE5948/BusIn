<?xml version="1.0" encoding="utf-8"?>

<!--  Default card gap in this card: 5sp -->
<!--  Defined in values/dimen/bus_arrival_card_gap  -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="110sp"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/gap"
    android:background="@drawable/bg_bus_arrival_details"
    android:orientation="vertical">

    <!-- TOP -->
    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="3sp"
        android:paddingEnd="0sp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvBusNumber"
            android:layout_marginStart="@dimen/bus_arrival_card_gap"
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="969"
            android:theme="@style/busNum" />

        <LinearLayout
            android:layout_width="0sp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView"
                android:theme="@style/busSchedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="First: 00:00" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:theme="@style/busSchedule"
                android:text="Last: 23:59" />
        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM -->
    <LinearLayout
        android:id="@+id/bottom"
        app:layout_constraintTop_toBottomOf="@id/top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="@dimen/bus_arrival_card_gap"
            android:background="@drawable/bg_bus_stop_section1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDuration1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Arr"
                android:theme="@style/busArrivalDuration" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivBus1"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:contentDescription="@string/Image_Desc"
                    android:layout_marginEnd="3sp"
                    app:srcCompat="@drawable/ic_bus" />

                <ImageView
                    android:id="@+id/ivWheelchair1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/Image_Desc"
                    app:srcCompat="@drawable/ic_wheelchair" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/bus_arrival_card_gap"
            android:background="@drawable/bg_bus_stop_section2"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDuration2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="10"
                android:theme="@style/busArrivalDuration" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivBus2"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:contentDescription="@string/Image_Desc"
                    android:layout_marginEnd="3sp"
                    app:srcCompat="@drawable/ic_bus" />

                <ImageView
                    android:id="@+id/ivWheelchair2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/Image_Desc"
                    app:srcCompat="@drawable/ic_wheelchair" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3 -->
        <LinearLayout
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="@dimen/bus_arrival_card_gap"
            android:background="@drawable/bg_bus_stop_section3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDuration3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Arr"
                android:theme="@style/busArrivalDuration" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivBus3"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:contentDescription="@string/Image_Desc"
                    android:layout_marginEnd="3sp"
                    app:srcCompat="@drawable/ic_bus" />

                <ImageView
                    android:id="@+id/ivWheelchair3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/Image_Desc"
                    app:srcCompat="@drawable/ic_wheelchair" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>