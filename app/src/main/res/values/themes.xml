<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SGBusAndLocationAlarm" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">@dimen/font_size_body</item>
        <item name="fontFamily">@font/arial</item>
        <item name="buttonStyle">@style/styleButton</item>
        <item name="dialogTheme">@style/FullDialog</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <!--            -->
    <!-- ACTION BAR -->
    <!--            -->
    <!-- Text Button -->
    <style name="styleActionBarTextButton" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">@dimen/font_size_body</item>
        <item name="fontFamily">@font/arial_bold</item>
    </style>
    <!-- Background -->
    <style name="actionBarBackground" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_action_bar</item>
    </style>

    <!--  Display  -->
    <style name="DisplayTheme" parent="TextAppearance.AppCompat">
        <item name="android:textSize">45sp</item>
        <item name="fontFamily">@font/dejanire_black</item>
    </style>

    <!--  Headline  -->
    <style name="HeadlineTheme" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">35sp</item>
        <item name="fontFamily">@font/dejanire_black</item>
    </style>

    <!--  Body  -->
    <style name="styleBody" parent="TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Custom theme for sign in activity -->
    <style name="AppThemeFirebaseAuth" parent="FirebaseUI">
        <item name="android:windowActionBarOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="buttonStyle">@style/styleButton</item>
    </style>

    <style name="buttonFire" parent="FirebaseUI.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/background</item>
        <item name="android:padding">@dimen/btn_padding</item>
        <item name="fontFamily">@font/arial_bold</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- Title -->
    <style name="FullDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:textColor">@color/red</item>
        <item name="android:textSize">28sp</item>
        <item name="fontFamily">@font/dejanire_black</item>
        <item name="android:layout_marginBottom">10sp</item>
        <item name="android:windowFrame">@null</item>
        <!-- turn off any drawable used to draw a frame on the window -->
        <item name="android:windowBackground">@null</item>
        <!-- turn off any drawable used to draw a frame on the window -->
        <item name="android:windowIsFloating">true</item>
        <!-- float the window so it does not fill the screen -->
        <item name="android:windowNoTitle">true</item>
        <!-- remove the title bar we make our own-->
        <item name="android:windowContentOverlay">@null</item>
        <!-- remove the shadow from under the title bar -->
    </style>

    <!-- EditText -->
    <style name="styleEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_edit_text</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textCursorDrawable">@drawable/et_cursor</item>
    </style>

    <!-- Buttons -->
    <style name="styleButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/background</item>
<!--        <item name="android:padding">@dimen/btn_padding</item>-->
        <item name="fontFamily">@font/arial_bold</item>
        <item name="textAllCaps">false</item>
    </style>
    <!-- Buttons (Alternate) -->
    <style name="styleButtonAlt" parent="styleButton">
        <item name="android:background">@drawable/bg_button_alt</item>
    </style>

    <!--          -->
    <!-- BUS STOP -->
    <!--          -->
    <style name="busStopCode" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">@dimen/label_small</item>
        <item name="fontFamily">@font/arial_bold</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="busStopDesc" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/arial_bold</item>
    </style>

    <style name="busStopRoad" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">@dimen/label</item>
        <item name="fontFamily">@font/arial</item>
        <item name="android:textStyle">italic</item>
    </style>


    <!--   Bus Arrival Details -->
    <style name="busNum" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">@dimen/body_medium</item>
        <item name="fontFamily">@font/arial_bold</item>
    </style>

    <style name="busSchedule" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_background_grey</item>
        <item name="android:textSize">@dimen/label_small</item>
        <item name="fontFamily">@font/arial</item>
    </style>

    <style name="busArrivalDuration" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">@dimen/body</item>
        <item name="fontFamily">@font/arial_bold</item>
        <item name="android:textAlignment">center</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="styleArrivalTime" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/dejanire_black</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="styleCheckboxText" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:textColor">@color/on_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/dejanire_black</item>
    </style>



    <style name="busService" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/arial_bold</item>
    </style>
    <style name="busServiceDetails" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">@dimen/body</item>
        <item name="fontFamily">@font/arial</item>
    </style>

    <!--  Bus Route  -->
    <style name="busRouteServiceDetails" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_secondary</item>
        <item name="android:textSize">@dimen/body_medium</item>
        <item name="fontFamily">@font/arial</item>
    </style>
    <style name="busRouteStopDesc" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@font/arial_bold</item>
    </style>
    <style name="busRouteStopCode" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_secondary</item>
        <item name="android:textSize">8sp</item>
        <item name="fontFamily">@font/arial</item>
        <item name="android:textStyle">italic</item>
    </style>
    <style name="busRouteDistance" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/on_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="fontFamily">@font/arial</item>
        <item name="android:textStyle">italic</item>
    </style>

    <!--          -->
    <!-- GEOFENCE -->
    <!--          -->

    <!-- Form Label -->
    <style name="styleNotifierCircleText" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/background</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/dejanire_black</item>
    </style>

    <style name="styleNotifierText" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/dejanire_black</item>
    </style>

    <style name="styleNotifierSubText" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@font/montserrat_regular</item>
    </style>

    <!-- Range Buttons -->
    <style name="styleRangeButtons" parent="Widget.AppCompat.Button">
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/dejanire_black</item>
        <item name="android:minHeight">0sp</item>
        <item name="android:minWidth">0sp</item>
    </style>

    <!-- Toggle - Notifier Type -->
    <!--    <style name="styleToggle_notifier_type" parent="Widget.AppCompat.CompoundButton.CheckBox">-->
    <!--        <item name="android:stateListAnimator">@animator/scale</item>-->
    <!--        <item name="android:checked">false</item>-->
    <!--        <item name="android:button">@null</item>-->
    <!--        <item name="android:layout_height">wrap_content</item>-->
    <!--        <item name="android:layout_width">wrap_content</item>-->
    <!--        <item name="android:background">@drawable/ic_ringtone_deselect</item>-->
    <!--        &lt;!&ndash;        <item name="android:gravity">end|center</item>&ndash;&gt;-->
    <!--    </style>-->

    <!-- SearchView-->
    <style name="SearchAutoCompleteTextView" parent="Widget.AppCompat.SearchView">
        <item name="queryHint">@string/Search_Hint</item>
        <item name="android:textColorHint">@color/hint</item>
        <item name="android:searchIcon">@drawable/ic_search</item>
        <item name="android:searchHintIcon">@drawable/ic_search</item>
        <item name="android:editTextColor">@color/on_background</item>
        <item name="fontFamily">@font/arial</item>
        <!--        TODO -->
        <item name="android:textSize">@dimen/body</item>
    </style>

    <style name="Theme.SGBusAndLocationAlarm" parent="Base.Theme.SGBusAndLocationAlarm" />
</resources>